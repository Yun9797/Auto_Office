# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.err.log

# env files (can opt-in for committing if needed)
.env*
# Cloudflare 로컬 비밀값 (예시 파일만 커밋)
.dev.vars
!.dev.vars.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# 날짜별 결과 기록 (잔고 금액 포함 — 공유 금지)
records/

# auto-risk (Python 백테스트): 가상환경·캐시·시세/결과 파일은 올리지 않음
.venv/
__pycache__/
*.pyc
/auto-risk/data/
/auto-risk/results/
*.tsbuildinfo
